{
  "name": "ziki-action-brief-verify",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "capture": "LD_LIBRARY_PATH=$HOME/pwlibs/root/usr/lib/aarch64-linux-gnu:$LD_LIBRARY_PATH node scripts/capture.mjs",
    "a11y": "LD_LIBRARY_PATH=$HOME/pwlibs/root/usr/lib/aarch64-linux-gnu:$LD_LIBRARY_PATH node scripts/a11y.mjs",
    "verify": "npm run build && npm run capture && npm run a11y"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.49.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
